@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet" href="~/css/pages/dashboard.css" asp-append-version="true" />

<div class="dashboard-page min-h-screen bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="mb-8">
            <p class="mb-1 text-sm font-medium text-teal-600">
                Vehicle Dashboard
            </p>

            <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
                Welcome back, @Model?.LoggedInUser?.userName
            </h1>

            <p class="mt-2 text-sm text-slate-500">
                Here's an overview of your vehicle and its maintenance.
            </p>
        </div>


        <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-500">
                            Vehicles
                        </p>

                        <p class="mt-1 text-2xl font-bold text-slate-900">
                            1
                        </p>
                    </div>
                    <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-50 text-teal-600">
                        <i class="fa-solid fa-car"></i>
                    </div>
                </div>
            </div>


            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-500">
                            Maintenance
                        </p>

                        <p class="mt-1 text-2xl font-bold text-slate-900">
                            3
                        </p>
                    </div>

                    <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                        <i class="fa-solid fa-screwdriver-wrench"></i>
                    </div>
                </div>
            </div>


            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-500">
                            Next Service
                        </p>

                        <p class="mt-1 text-lg font-bold text-slate-900">
                            2,500 km
                        </p>
                    </div>

                    <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>
                </div>
            </div>
        </div>


        <div class="mb-4 flex items-center justify-between">
            <div>
                <h2 class="text-lg font-semibold text-slate-900">
                    My Vehicle
                </h2>

                <p class="mt-1 text-sm text-slate-500">
                    Vehicle information and maintenance overview.
                </p>
            </div>
        </div>

        @if (Model?.MyVehicles == null || !Model.MyVehicles.Any())
        {
            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                <div class="flex items-center justify-between p-6">
                    <div>
                        <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                            Vehicles
                        </p>

                        <h3 class="mt-1 text-lg font-bold text-slate-900">
                            No vehicles added
                        </h3>

                        <p class="mt-1 text-sm text-slate-500">
                            Add your first vehicle to start tracking its maintenance.
                        </p>
                    </div>

                    <a href="/AddVehicle"
                       title="Add a New Vehicle to Your Profile"
                       class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-500 transition hover:bg-teal-50 hover:text-teal-600">

                        <i class="fa-solid fa-plus"></i>
                    </a>
                </div>
            </div>
        }
        else
        {
            @foreach (var vehicle in Model.MyVehicles)
            {
                <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm mb-4">
                    <div class="flex flex-col lg:flex-row lg:items-center">
                        <div class="flex items-center gap-4 p-6 lg:w-1/4">

                            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-teal-50 text-teal-600">
                                <i class="fa-solid fa-car-side text-xl"></i>
                            </div>

                            <div>
                                <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                                    Vehicle
                                </p>

                                <h3 class="mt-1 text-lg font-bold text-slate-900">
                                    @vehicle.txtModelName
                                </h3>

                                <p class="text-sm text-slate-500">
                                    @vehicle.makeYear
                                </p>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 border-t border-slate-100 px-6 py-5 sm:grid-cols-4 lg:flex-1 lg:border-l lg:border-t-0">
                            <div class="border-r border-slate-100 px-4 first:pl-0 sm:px-6">
                                <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                                    Make
                                </p>

                                <p class="mt-1 text-sm font-semibold text-slate-800">
                                    @vehicle.txtMakeName
                                </p>
                            </div>

                            <div class="border-r border-slate-100 px-4 sm:px-6">
                                <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                                    Model
                                </p>

                                <p class="mt-1 text-sm font-semibold text-slate-800">
                                    @vehicle.txtModelName
                                </p>
                            </div>

                            <div class="border-r border-slate-100 px-4 sm:px-6">
                                <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                                    Mileage
                                </p>

                                <p class="mt-1 text-sm font-semibold text-slate-800">
                                    @vehicle.mileage km
                                </p>
                            </div>

                            <div class="px-4 sm:px-6">
                                <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                                    Warranty
                                </p>

                                @if (vehicle.isActive == true)
                                {
                                    <div class="mt-1 flex items-center gap-2">
                                        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>

                                        <span class="text-sm font-semibold text-emerald-600">
                                            Active
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div class="mt-1 flex items-center gap-2">
                                        <span class="h-2 w-2 rounded-full bg-slate-400"></span>

                                        <span class="text-sm font-semibold text-slate-500">
                                            Not Covered
                                        </span>
                                    </div>
                                }

                            </div>
                        </div>

                        <div class="border-t border-slate-100 p-4 lg:border-l lg:border-t-0">
                            <a href="/Vehicle?id=@vehicle.pkiVehicleId"
                               title="View vehicle maintenance details"
                               class="flex h-11 w-11 items-center justify-center rounded-xl bg-slate-100 text-slate-500 transition hover:bg-teal-50 hover:text-teal-600">

                                <i class="fa-solid fa-eye"></i>
                            </a>
                        </div>

                    </div>
                </div>
            }
        }
    </div>
</div>