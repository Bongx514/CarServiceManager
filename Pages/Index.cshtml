@page
@model IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="min-h-screen bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="mb-1 text-sm font-semibold text-teal-600">
                    ADMINISTRATION
                </p>
                <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
                    Dashboard Overview
                </h1>
                <p class="mt-2 text-sm text-slate-500">
                    Welcome back, @(Model?.LoggedInUser?.userName ?? "Administrator"). Here's what's happening across Car Service Manager.
                </p>
            </div>

            <div class="flex flex-wrap items-center gap-3">
                <a href="/Schedule"
                   class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-teal-200 hover:bg-teal-50 hover:text-teal-700">
                    <i class="fa-solid fa-calendar-days"></i>
                    View Schedule
                </a>

                <a href="/Support"
                   class="inline-flex items-center justify-center gap-2 rounded-xl bg-teal-600 px-4 py-2.5 text-sm font-semibold text-white shadow-lg shadow-teal-600/20 transition hover:bg-teal-700">
                    <i class="fa-solid fa-headset"></i>
                    Support Centre
                </a>
            </div>
        </div>

        <div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
            <partial name="Components/Home/_SummaryTiles" model="Model" />
        </div>

        <div class="mb-8 grid grid-cols-1 gap-6 xl:grid-cols-3">
            <partial name="Components/Home/_PlatformActivity" model="Model" />
            <partial name="Components/Home/_NeedsAttention" model="Model" />
        </div>

        <div class="mb-8 grid grid-cols-1 gap-6 lg:grid-cols-3">
            <partial name="Components/Home/_RecentActivity" model="Model" />
            <partial name="Components/Home/_QuickActions" model="Model" />
        </div>

        <div class="flex flex-col gap-2 border-t border-slate-200 pt-5 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-xs text-slate-400">
                Car Service Manager · Administration Dashboard
            </p>
            <p class="text-xs text-slate-400">
                Dashboard figures are illustrative until connected to live data.
            </p>
        </div>

    </div>
</div>