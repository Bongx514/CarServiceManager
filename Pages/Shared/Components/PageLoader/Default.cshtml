<div id="page-loader"
     class="fixed inset-0 z-[9999] flex items-center justify-center bg-white transition-opacity duration-300"
     aria-label="Loading"
     role="status">

    <div class="flex flex-col items-center">

        <!-- Spinner -->
        <div class="relative h-12 w-12">

            <div class="absolute inset-0 rounded-full border-4 border-slate-200"></div>

            <div class="absolute inset-0 animate-spin rounded-full border-4 border-transparent border-t-teal-600"></div>

        </div>

        <!-- Loading text -->
        <p class="mt-4 text-sm font-medium text-slate-600">
            Loading...
        </p>

        <p class="mt-1 text-xs text-slate-400">
            Please wait
        </p>

    </div>

</div>

