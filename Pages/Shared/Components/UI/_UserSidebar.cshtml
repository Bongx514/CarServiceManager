           aria-modal="true"
           aria-labelledby="accountHeading"
           aria-hidden="true"
           aria-expand="false"
           inert
           class="fixed right-0 top-0 z-[100] flex h-dvh w-full max-w-sm translate-x-full flex-col border-l border-slate-200 bg-white shadow-2xl transition-transform duration-300 ease-in-out sm:max-w-md">

        <!-- Header -->
        <div class="flex items-center justify-between border-b border-slate-100 px-6 py-5">
            <div class="flex items-center gap-3">
                <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-teal-50 text-teal-600">
                    <i class="fa-solid fa-user-gear text-lg"></i>
                </div>
                <div>
