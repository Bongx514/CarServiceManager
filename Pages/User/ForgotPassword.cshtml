@page "/forgot-password"
@model CarServiceManager.Pages.User.ForgotPasswordModel
@{
}

<main class="flex min-h-screen flex-col">

    <section class="flex flex-1 items-center justify-center px-4 py-12 sm:px-6">
        <div class="w-full max-w-md">

            <a href="/Login" class="mb-8 inline-flex items-center gap-2 text-sm font-medium text-slate-500 transition hover:text-teal-600">
                <i class="fa-solid fa-arrow-left"></i>
                Back to login
            </a>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">

                <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-teal-50 text-teal-600">
                    <i class="fa-solid fa-lock text-2xl"></i>
                </div>

                <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-teal-600">
                    Account recovery
                </p>

                <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
                    Forgot your password?
                </h1>

                <p class="mt-3 text-sm leading-6 text-slate-500">
                    No worries. Enter the email address associated with your account and we'll help you reset your password.
                </p>

                <form id="forgotPasswordForm" class="mt-8 space-y-5">

                    <div>
                        <label for="email" class="mb-2 block text-sm font-semibold text-slate-700">
                            Email address
                        </label>

                        <div class="relative">
                            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
                                <i class="fa-regular fa-envelope"></i>
                            </span>

                            <input id="email"
                                    name="email"
                                    type="email"
                                    autocomplete="email"
                                    placeholder="you@example.com"
                                    required
                                    class="w-full rounded-xl border border-slate-200 bg-white py-3 pl-11 pr-4 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-teal-500 focus:ring-4 focus:ring-teal-500/10" />
                        </div>
                    </div>

                    <div id="formMessage"
                            class="hidden rounded-xl border px-4 py-3 text-sm"
                            role="status"
                            aria-live="polite"></div>

                    <button id="submitButton"
                            type="submit"
                            class="flex w-full items-center justify-center gap-2 rounded-xl bg-teal-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-teal-700 focus:outline-none focus:ring-4 focus:ring-teal-500/20">
                        <span>Send reset instructions</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>

                </form>

                <div class="mt-6 flex items-start gap-3 rounded-xl bg-slate-50 p-4">
                    <i class="fa-solid fa-shield-halved mt-0.5 text-teal-600"></i>
                    <p class="text-xs leading-5 text-slate-500">
                        For your security, password reset requests should be verified before any account credentials are changed.
                    </p>
                </div>
            </div>

            <p class="mt-6 text-center text-xs text-slate-400">
                Remember your password?
                <a href="/Login" class="font-semibold text-teal-700 transition hover:text-teal-800">
                    Sign in
                </a>
            </p>

        </div>
    </section>

    <footer class="border-t border-slate-200 bg-white px-4 py-5 text-center">
        <p class="text-xs text-slate-400">
            &copy; @DateTime.Now.Year Car Service Manager. All rights reserved.
        </p>
    </footer>

</main>

<script>
    const form = document.getElementById("forgotPasswordForm");
    const emailInput = document.getElementById("email");
    const formMessage = document.getElementById("formMessage");
    const submitButton = document.getElementById("submitButton");

    form.addEventListener("submit", function (event) {
        event.preventDefault();

        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        formMessage.className = "mt-4 rounded-xl border border-teal-200 bg-teal-50 px-4 py-3 text-sm text-teal-800";
        formMessage.textContent = "The form is ready for password-reset API integration. No email has been sent yet.";

        submitButton.innerHTML = '<span>Request captured in demo</span><i class="fa-solid fa-check"></i>';
        submitButton.disabled = true;
        submitButton.classList.add("cursor-not-allowed", "opacity-70");
    });
</script>