@page "/MyVehicles"
@model CarServiceManager.Pages.Vehicle.MyVehiclesModel
@{
    ViewData["Title"] = "My Vehicles";
}

<div class="min-h-screen bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-sm font-medium text-teal-600">
                    Vehicle Management
                </p>

                <h1 class="mt-1 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
                    My Vehicles
                </h1>

                <p class="mt-2 text-sm text-slate-500">
                    Manage your vehicles and keep track of their maintenance.
                </p>
            </div>

            <a href="/AddVehicle"
               class="inline-flex items-center justify-center rounded-xl bg-teal-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-teal-600/20 transition hover:bg-teal-700 focus:outline-none focus:ring-4 focus:ring-teal-500/20 active:scale-[0.99]">

                <i class="fa-solid fa-plus mr-2"></i>

                Add Vehicle

            </a>
        </div>


        <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-500">
                            Total Vehicles
                        </p>

                        <p class="mt-1 text-2xl font-bold text-slate-900">
                            2
                        </p>
                    </div>

                    <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-50 text-teal-600">
                        <i class="fa-solid fa-car"></i>
                    </div>
                </div>
            </div>


            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-500">
                            Under Warranty
                        </p>

                        <p class="mt-1 text-2xl font-bold text-slate-900">
                            1
                        </p>
                    </div>

                    <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                        <i class="fa-solid fa-shield-check"></i>
                    </div>
                </div>
            </div>


            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-500">
                            Upcoming Services
                        </p>

                        <p class="mt-1 text-2xl font-bold text-slate-900">
                            1
                        </p>
                    </div>

                    <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>
                </div>
            </div>
        </div>


        <div class="mb-4 flex items-center justify-between">
            <div>
                <h2 class="text-lg font-semibold text-slate-900">
                    Your Vehicles
                </h2>

                <p class="mt-1 text-sm text-slate-500">
                    Select a vehicle to view or manage its details.
                </p>
            </div>
        </div>


        <div class="space-y-4">
           //I wiil add a component here later
        </div>
    </div>
</div>